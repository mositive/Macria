<UserControl x:Class="Macria.Step3BPaneli"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Macria">
    <!-- Ortak 3B onizleme: arac cubugu, OCCT gorunumu ve durum satiri.
         Dosya Analiz Merkezi sekmeleri ve Buyuk Ac penceresi ayni bileseni kullanir. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="pnlBaslik" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="txtBaslik" Text="Listeden Bir STEP Seçin"
                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="txtYol" Margin="0,3,0,0" FontSize="11.5"
                       Foreground="{StaticResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <WrapPanel x:Name="aracCubugu" Grid.Row="1" Margin="0,0,0,3">
            <Button x:Name="btnBuyukAc" Style="{StaticResource SecondaryButton}" Content="Büyük Aç" IsEnabled="False" Click="btnBuyukAc_Click"/>
            <Button x:Name="btnParcaGorunumu" Style="{StaticResource SecondaryButton}" Content="Montaj içinde göster"
                    Visibility="Collapsed" IsEnabled="False" Click="btnParcaGorunumu_Click"
                    ToolTip="Seçili parçayı tek başına ya da montajın içinde (diğerleri soluk) gösterir"/>
            <Button x:Name="btnIzometrik" Style="{StaticResource SecondaryButton}" Content="İzometrik" IsEnabled="False" Click="btnIzometrik_Click"/>
            <Button x:Name="btnOn" Style="{StaticResource SecondaryButton}" Content="Ön" IsEnabled="False" Click="btnOn_Click"/>
            <Button x:Name="btnArka" Style="{StaticResource SecondaryButton}" Content="Arka" IsEnabled="False" Click="btnArka_Click"/>
            <Button x:Name="btnSol" Style="{StaticResource SecondaryButton}" Content="Sol" IsEnabled="False" Click="btnSol_Click"/>
            <Button x:Name="btnSag" Style="{StaticResource SecondaryButton}" Content="Sağ" IsEnabled="False" Click="btnSag_Click"/>
            <Button x:Name="btnUst" Style="{StaticResource SecondaryButton}" Content="Üst" IsEnabled="False" Click="btnUst_Click"/>
            <Button x:Name="btnAlt" Style="{StaticResource SecondaryButton}" Content="Alt" IsEnabled="False" Click="btnAlt_Click"/>
            <Button x:Name="btnSigdir" Style="{StaticResource SecondaryButton}" Content="Sığdır" IsEnabled="False" Click="btnSigdir_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#1B2028">
            <local:OcctViewportHost x:Name="viewport"/>
        </Border>

        <TextBlock x:Name="txtDurum" Grid.Row="3" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="3B önizleme hazırlanıyor..."/>
    </Grid>
</UserControl>
