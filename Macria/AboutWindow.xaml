<ui:FluentWindow x:Class="Macria.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hakkında"
        Icon="Assets/macria-logo.png"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <!-- WPF UI sozlukleri yalnizca bu pencereye uygulanir; App.xaml temasina dokunmaz. -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>

                <!-- Ayrı sözlük: anahtarlı öğeler WPF UI sözlükleriyle aynı sözlükte dururken
                     çalışma anında karışıyordu (19 anahtardan 8'i, yanlış değerlerle). -->
                <ResourceDictionary>
                    <!-- Vurgu ve zemin: WPF UI bunlari normalde uygulama duzeyinde (ApplicationAccentColorManager)
                         ekler. Pencere kapsaminda eksik kaldiklari icin burada App.xaml token'larina baglanir.
                         AccentFillColorDisabled ve SystemAccentColorPrimary eksikken AccentFillColorDisabledBrush
                         ve BadgeBackground cozulemiyor (XamlParseException). Renk degerleri App.xaml ile ayni. -->
                    <Color x:Key="SystemAccentColor">#2E64AC</Color>
                    <Color x:Key="SystemAccentColorPrimary">#3B74C0</Color>
                    <Color x:Key="SystemAccentColorSecondary">#2E64AC</Color>
                    <Color x:Key="SystemAccentColorTertiary">#24507F</Color>
                    <Color x:Key="AccentFillColorDisabled">#28FFFFFF</Color>
                    <Color x:Key="TextOnAccentFillColorPrimary">#ECEAE2</Color>
                    <Color x:Key="ApplicationBackgroundColor">#262624</Color>

                    <StaticResource x:Key="SystemAccentColorBrush" ResourceKey="AccentBrush"/>
                    <StaticResource x:Key="SystemAccentColorPrimaryBrush" ResourceKey="AccentHoverBrush"/>
                    <StaticResource x:Key="SystemAccentColorSecondaryBrush" ResourceKey="AccentBrush"/>
                    <StaticResource x:Key="SystemAccentColorTertiaryBrush" ResourceKey="AccentPressedBrush"/>
                    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AccentBrush"/>
                    <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AccentHoverBrush"/>
                    <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AccentPressedBrush"/>
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#28FFFFFF"/>
                    <StaticResource x:Key="BadgeBackground" ResourceKey="AccentBrush"/>
                    <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="TextPrimaryBrush"/>
                    <StaticResource x:Key="TextOnAccentFillColorSecondaryBrush" ResourceKey="TextSecondaryBrush"/>
                    <StaticResource x:Key="ApplicationBackgroundBrush" ResourceKey="BgBrush"/>

                    <!-- Appearance="Primary" dugme bu anahtarlari kullanir; pencere kapsaminda
                         seffaf zemin ve siyah yaziya dusuyorlardi. -->
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentBrush"/>
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentHoverBrush"/>
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentPressedBrush"/>
                    <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="AccentPressedBrush"/>
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextPrimaryBrush"/>
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush"/>
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextSecondaryBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======== BASLIK CUBUGU ======== -->
        <ui:TitleBar Grid.Row="0" Title="Hakkında"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False"/>

        <!-- ======== ICERIK ======== -->
        <StackPanel Grid.Row="1" Margin="24,8,24,0">

            <!-- Uygulama kimligi -->
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/macria-logo.png" Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Macria" FontSize="28" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"/>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="8,1" Margin="0,4,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="txtVersion" Text="Sürüm 1.0.0" FontSize="12"
                                   Foreground="{StaticResource AccentHoverBrush}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="CATIA / 3DEXPERIENCE montajlarındaki sac parçaları tarar, kalınlık ve adet bilgisiyle listeler ve tek tuşla DXF olarak dışa aktarır."
                       FontSize="13" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,16,0,0"/>

            <!-- Gelistiriciler -->
            <TextBlock Text="Geliştiriciler" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,22,0,0"/>

            <ui:Card Padding="14,12" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Person24" FontSize="16"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Emre Koçak" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:SymbolIcon Symbol="Person24" FontSize="16"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Enes Yeşilöz" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Sistem bilgileri -->
            <TextBlock Text="Sistem Bilgileri" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,22,0,0"/>

            <ui:Card Padding="14,12" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Çalışma Zamanı" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtRuntime" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="İşletim Sistemi" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtOs" FontSize="12"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mimari" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtArch" FontSize="12"
                               Margin="0,8,0,0"/>
                </Grid>
            </ui:Card>

            <!-- Ucuncu taraf yazilimlar: OCCT exception'in istedigi belirgin bildirim,
                 ozet ve tam metinlere / kaynak koduna giden dugmeler -->
            <TextBlock Text="Üçüncü taraf yazılımlar" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,22,0,0"/>

            <ui:Card Padding="14,12" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="txtOcctBildirimi" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock x:Name="txtUcuncuTarafOzet" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button x:Name="btnLisanslar" Content="Lisanslar…"
                                   Icon="{ui:SymbolIcon DocumentText24}" Margin="0,0,8,0"
                                   Click="btnLisanslar_Click"/>
                        <ui:Button x:Name="btnKaynakKodu" Content="Kaynak kodu…"
                                   Icon="{ui:SymbolIcon Code24}"
                                   Click="btnKaynakKodu_Click"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <!-- ======== ALT SERIT ======== -->
        <Grid Grid.Row="2" Margin="24,20,24,20">
            <TextBlock x:Name="txtCopyright" FontSize="12"
                       Foreground="{StaticResource TextDisabledBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="btnKopyala" Content="Bilgileri kopyala"
                           Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0"
                           Click="btnKopyala_Click"/>
                <ui:Button Content="Kapat" Appearance="Primary"
                           IsDefault="True" IsCancel="True"
                           Click="btnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
