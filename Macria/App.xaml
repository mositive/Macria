<Application x:Class="Macria.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Macria"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- Buton ikonlari (Tasarim/Macria_Tum_Butonlar_WPF): DrawingImage "Icon.*" anahtarlari -->
            <ResourceDictionary Source="Ikonlar/MacriaAllIcons.xaml"/>
            <!-- Sekme ikonlari (Macria_Sekmeler_WPF; TabIcon.Profiles: Macria_Uzun_Profil) -->
            <ResourceDictionary Source="Ikonlar/MacriaTabResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- ======== FONTLAR ======== -->
        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="AppFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ======== RENKLER (sicak antrasit, Claude tarzi) ======== -->
        <SolidColorBrush x:Key="BgBrush" Color="#262624"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2B2B29"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#30302E"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3A3A37"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#424240"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEAE2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5A399"/>
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#757369"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2E64AC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B74C0"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#24507F"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4C"/>
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#379457"/>
        <SolidColorBrush x:Key="SuccessPressedBrush" Color="#256B40"/>
        <SolidColorBrush x:Key="RowSelectedBrush" Color="#32405A"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#383835"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#45453F"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#55554F"/>
        <SolidColorBrush x:Key="ConsoleBgBrush" Color="#1B1B1A"/>
        <SolidColorBrush x:Key="LogInfoBrush" Color="#6CB2FF"/>
        <SolidColorBrush x:Key="LogSuccessBrush" Color="#4CC38A"/>
        <SolidColorBrush x:Key="LogErrorBrush" Color="#F05B50"/>

        <!-- ======== BUTON IKONLARI ======== -->
        <!-- Ikonlarin ana cizgi rengi: tema metin rengiyle ayni. IkonluDugmeIcerigi bunu
             DynamicResource ile okur ve ikonu boyar (DugmeIkonu.Boyayici); acik bir tema bu
             fircayi koyu bir renkle degistirir. Vurgu renkleri ikonun kendisinde kalir. -->
        <SolidColorBrush x:Key="MacriaIconForeground" Color="#ECEAE2"/>
        <!-- "Buton gorunumu" (Ayarlar): DugmeIkonu.YalnizIkon bu ikisini degistirir -->
        <Visibility x:Key="DugmeYazisiGorunurlugu">Visible</Visibility>
        <Thickness x:Key="DugmeIkonBoslugu">0,0,6,0</Thickness>
        <!-- "Ikon boyutu" (Ayarlar): Kucuk 16 / 36, Orta 24 / 40, Buyuk 32 / 48 -->
        <sys:Double x:Key="DugmeIkonBoyutu">16</sys:Double>
        <sys:Double x:Key="DugmeYuksekligi">36</sys:Double>
        <sys:Double x:Key="DugmeKareGenislik">0</sys:Double>
        <Thickness x:Key="DugmeIcBoslugu">10,0,10,0</Thickness>
        <!-- local:DugmeIkonu.Ikon verilen butonun icerigi: ikon + metin (Content metin kalir) -->
        <DataTemplate x:Key="IkonluDugmeIcerigi">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ikon" Width="{DynamicResource DugmeIkonBoyutu}" Height="{DynamicResource DugmeIkonBoyutu}"
                       Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                       Margin="{DynamicResource DugmeIkonBoslugu}"
                       local:DugmeIkonu.CizgiFircasi="{DynamicResource MacriaIconForeground}">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="donus"/>
                    </Image.RenderTransform>
                    <Image.Source>
                        <MultiBinding Converter="{x:Static local:DugmeIkonu.Boyayici}">
                            <Binding Path="(local:DugmeIkonu.Ikon)" RelativeSource="{RelativeSource AncestorType=ButtonBase}"/>
                            <Binding Path="(local:DugmeIkonu.CizgiFircasi)" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <TextBlock x:Name="yazi" Text="{Binding}" VerticalAlignment="Center" Visibility="{DynamicResource DugmeYazisiGorunurlugu}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Her gorunumde yalniz ikon (DugmeIkonu.HepIkon) -->
                <DataTrigger Binding="{Binding (local:DugmeIkonu.HepIkon), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                    <Setter TargetName="yazi" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ikon" Property="Margin" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="False">
                    <Setter TargetName="ikon" Property="Opacity" Value="0.38"/>
                </DataTrigger>
                <!-- Is surerken ikon doner (DugmeIkonu.Donuyor) -->
                <DataTrigger Binding="{Binding (local:DugmeIkonu.Donuyor), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="donusAnimasyonu">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="donus" Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="donusAnimasyonu"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- local:DugmeIkonu.Ikon verilen sekmenin basligi: ikon + ad + adet (Header metni sayac bagina bagli kalir) -->
        <DataTemplate x:Key="IkonluSekmeBasligi">
            <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                       local:DugmeIkonu.CizgiFircasi="{DynamicResource MacriaIconForeground}">
                    <Image.Source>
                        <MultiBinding Converter="{x:Static local:DugmeIkonu.Boyayici}">
                            <Binding Path="(local:DugmeIkonu.Ikon)" RelativeSource="{RelativeSource AncestorType=TabItem}"/>
                            <Binding Path="(local:DugmeIkonu.CizgiFircasi)" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Ince, yuvarlak ilerleme cubugu: sayili asamada vurgu renginde dolar;
             sayisiz asamada iz boyunca yumusak bir isik kayar (genislikten bagimsiz,
             firca goreli koordinatta kaydirilir). -->
        <Style x:Key="ModernIlerleme" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#3A3A37"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2E64AC" Offset="0"/>
                                            <GradientStop Color="#5A9BE6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="kayanIsik" CornerRadius="3" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform X="-1"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#002E64AC" Offset="0.25"/>
                                            <GradientStop Color="#FF5A9BE6" Offset="0.5"/>
                                            <GradientStop Color="#002E64AC" Offset="0.75"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="kayanIsik" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="isikKaydir">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="kayanIsik"
                                                             Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-0.75" To="0.75" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="isikKaydir"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Ana menu kutucuklari (Windows 8 tarzi) -->
        <SolidColorBrush x:Key="TileTextBrush" Color="#F4F2EB"/>
        <SolidColorBrush x:Key="TileSubTextBrush" Color="#C9C7BF"/>
        <SolidColorBrush x:Key="TileNeutralBrush" Color="#3B3B38"/>
        <SolidColorBrush x:Key="TileNeutralAltBrush" Color="#4A4944"/>
        <SolidColorBrush x:Key="TileTealBrush" Color="#2F6E6A"/>

        <!-- Ham sac hatirlatmasi ve degistirilmis satirlar -->
        <SolidColorBrush x:Key="HamSacReminderBrush" Color="#223B39"/>
        <SolidColorBrush x:Key="HamSacReminderBorderBrush" Color="#3B7772"/>
        <SolidColorBrush x:Key="HamSacReminderTextBrush" Color="#9ADDD6"/>
        <SolidColorBrush x:Key="HamSacChangedRowBrush" Color="#244744"/>
        <SolidColorBrush x:Key="HamSacChangedRowHoverBrush" Color="#2B5652"/>

        <!-- Birden fazla katı Body bulunan ve güvenli DXF açılamayan satırlar -->
        <!-- Coklu Body, genel DXF hatasindan farkli ve dikkat cekici amber renktedir. -->
        <SolidColorBrush x:Key="MultiBodyRowBrush" Color="#463B22"/>
        <SolidColorBrush x:Key="MultiBodyRowHoverBrush" Color="#574928"/>
        <SolidColorBrush x:Key="MultiBodyRowSelectedBrush" Color="#66542E"/>
        <SolidColorBrush x:Key="MultiBodyNoteBrush" Color="#F2C66D"/>
        <SolidColorBrush x:Key="MultiBodyAccentBrush" Color="#F2B84B"/>

        <!-- Diger DXF hatalari kirmizi; gizli urunler ise soluk gri-mavi gorunur. -->
        <SolidColorBrush x:Key="DxfFailedRowBrush" Color="#4A3032"/>
        <SolidColorBrush x:Key="DxfFailedRowHoverBrush" Color="#5A383B"/>
        <SolidColorBrush x:Key="DxfFailedRowSelectedBrush" Color="#684044"/>
        <SolidColorBrush x:Key="HiddenProductRowBrush" Color="#292D31"/>
        <SolidColorBrush x:Key="HiddenProductRowHoverBrush" Color="#32373C"/>
        <SolidColorBrush x:Key="HiddenProductRowSelectedBrush" Color="#3A424B"/>
        <SolidColorBrush x:Key="HiddenProductTextBrush" Color="#8B9298"/>

        <!-- Ozet kartlari (Agirlik ve Maliyet) -->
        <SolidColorBrush x:Key="KpiNeutralBgBrush" Color="#2F2F2C"/>
        <SolidColorBrush x:Key="KpiNeutralBorderBrush" Color="#3D3D39"/>
        <SolidColorBrush x:Key="KpiBlueBgBrush" Color="#212B3A"/>
        <SolidColorBrush x:Key="KpiBlueBorderBrush" Color="#2E3D52"/>
        <SolidColorBrush x:Key="KpiGreenBgBrush" Color="#1D2B25"/>
        <SolidColorBrush x:Key="KpiGreenBorderBrush" Color="#2A3D34"/>
        <SolidColorBrush x:Key="KpiWarmBgBrush" Color="#2F2820"/>
        <SolidColorBrush x:Key="KpiWarmBorderBrush" Color="#42382C"/>
        <SolidColorBrush x:Key="WarnTextBrush" Color="#E0A458"/>

        <!-- ======== ACILIR LISTE ======== -->
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260" Margin="0,2,0,0" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="tb" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== METRO KUTUCUK ======== -->
        <!-- Duz renk, keskine yakin kose, basinca hafif kuculme.
             Golge ya da parlama yok. -->
        <Style x:Key="MetroTile" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TileTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="2" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="16"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                            <Border x:Name="ov" Background="#FFFFFF" Opacity="0"
                                    CornerRadius="2" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ov" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ov" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ov" Property="Opacity" Value="0.15"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======== BIRINCIL BUTON ======== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== YESIL BUTON (toplu export ana aksiyonu) ======== -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SuccessPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== IKINCIL BUTON ======== -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Konsol seridindeki kucuk ikon butonlari -->
        <Style x:Key="ConsoleToolButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== ARAMA KUTUSU ======== -->
        <!-- Ayarlar penceresindeki sade giris kutusu -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="9,0"
                                          VerticalAlignment="Center"
                                          Background="Transparent" BorderThickness="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Background="Transparent" BorderThickness="0"/>
                                <TextBlock Grid.Column="1" x:Name="placeholder"
                                           Text="Ürün veya Parça Ara"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="2,0,0,0" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#55554F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== ONAY KUTUSU ======== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3.5,8 L 6.8,11.2 L 12.5,4.8"
                                      Stroke="#FFFFFF" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource TextDisabledBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== TOOLTIP ======== -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8">
                            <StackPanel>
                                <!-- Yalniz ikon modunda butonun adi (DugmeIkonu.IpucuBasligi) -->
                                <TextBlock x:Name="ipucuBasligi" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Text="{Binding PlacementTarget.(local:DugmeIkonu.IpucuBasligi), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.(local:DugmeIkonu.IpucuBasligi), RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                <Setter TargetName="ipucuBasligi" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== SAG TIK MENUSU ======== -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="12,7">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== PENCERE BUTONLARI ======== -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== SCROLLBAR ======== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="{StaticResource ScrollThumbBrush}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" Margin="2,0"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" Margin="0,2"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======== DATAGRID ======== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <!-- Grid kullaniliyor: yatay StackPanel icinde basliklar
                                     sinirsiz genislik gordugu icin sarilamiyor, kirpiliyordu -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                    <Path x:Name="sortArrow" Grid.Column="1" Visibility="Collapsed"
                                          Data="M 0,0 L 7,0 L 3.5,4.5 Z"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Margin="6,1,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Kolon genisligi surukleme tutamaclari -->
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Width="5" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Width="5" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="sortArrow" Property="Data" Value="M 0,4.5 L 7,4.5 L 3.5,0 Z"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Durum hucresi: basarili yesil, hatali kirmizi noktayla gosterilir -->
        <DataTemplate x:Key="DurumHucre">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource LogErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Durum}" Value="Ölçüldü">
                                    <Setter Property="Fill" Value="{StaticResource LogSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Durum}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Durum}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource LogErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Durum}" Value="Ölçüldü">
                                    <Setter Property="Foreground" Value="{StaticResource LogSuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Sayi sutunlari saga yaslanir; toplam sutunu vurgulu yazilir -->
        <!-- Sayi hucresi saga yasli; sigmazsa soldan sessizce kesilmesin: "…" ile
             kisalir, ipucunda tam deger gorunur. -->
        <Style x:Key="SayiHucre" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="VurguHucre" TargetType="TextBlock" BasedOn="{StaticResource SayiHucre}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
        </Style>

        <Style x:Key="SayiBaslik" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Uzun metin sutunlari: sigmayan metin "..." ile kisalir, tamami ipucunda -->
        <Style x:Key="KirpilanHucre" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Tek satirlari hafif koyu: uzun tabloda satir takibi kolaylasir.
             Tetikleyici sirasi onemli, fare/secim vurgusu en sonda kalmali. -->
        <Style x:Key="ZebraRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
