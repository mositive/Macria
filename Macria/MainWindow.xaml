                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ======== SAYFA BASLIGI ======== -->
                <Grid Grid.Row="0" Margin="24,10,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Ağırlık ve Maliyet" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"/>
                        <TextBlock Text="Parçaların Hacmi ve Yüzeyi CATIA'dan Ölçülür, Ağırlık ve Kesim Maliyeti Hesaplanır"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnTabloAyarlari" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                ToolTip="Sütunları Düzenle, Kendi Sütununu Ekle"
                                Click="btnTabloAyarlari_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Tablo Ayarları" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Isi haritasi: acikken dugme dolu gorunur -->
                        <Button x:Name="btnIsiHaritasi" Style="{StaticResource SecondaryButton}"
                                Width="34" Height="30" Padding="0" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Isı Haritası — Hücreleri Sütun İçindeki Değerine Göre Tonla"
                                Click="btnIsiHaritasi_Click">
                            <Border Width="15" Height="15" CornerRadius="2"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Color="#3A3A36" Offset="0"/>
                                        <GradientStop Color="#B8873F" Offset="0.55"/>
                                        <GradientStop Color="#B44638" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Button>

                        <Button x:Name="btnGrafikler" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="Ağırlık ve Maliyet Dağılımını Grafiklerle Gör"
                                Click="btnGrafikler_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- Cubuk grafik simgesi: yazi tipine bagli kalmasin diye cizili -->
                                <Path Data="M0,7 H3 V12 H0 Z M4.5,3 H7.5 V12 H4.5 Z M9,5.5 H12 V12 H9 Z"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Grafikler" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnNesting" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="Kalınlığa Göre Tahmini Plaka Tüketimini Hesapla"
                                Click="btnNesting_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- Plaka uzerine yerlesmis parcalar; cizili simge -->
                                <Grid Width="15" Height="11" VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                    <Border BorderBrush="{StaticResource TextPrimaryBrush}"
                                            BorderThickness="1" CornerRadius="1"/>
                                    <Rectangle Width="5" Height="4" Margin="2,2,0,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Fill="{StaticResource TextPrimaryBrush}"/>
                                    <Rectangle Width="3" Height="5" Margin="0,0,2,2"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Fill="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <TextBlock Text="Plaka Tüketimi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCostClear" Style="{StaticResource SecondaryButton}"
                                Content="Tabloyu Temizle" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Click="btnCostClear_Click"/>

                        <Button x:Name="btnCostExport" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="Hesaplanmış Tabloyu Excel veya PDF Olarak Kaydet"
                                Click="btnCostExport_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="mnuCostExport">
                                    <MenuItem Click="mnuExcelAktar_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="16" CornerRadius="2"
                                                        Background="#1D6F42">
                                                    <TextBlock Text="XLSX" FontSize="8"
                                                               FontWeight="Bold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Excel Çalışma Kitabı (.xlsx)"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="mnuPdfAktar_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="16" CornerRadius="2"
                                                        Background="#B0322A">
                                                    <TextBlock Text="PDF" FontSize="8"
                                                               FontWeight="Bold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="PDF Belgesi (.pdf)"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Dışarı Aktar" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" VerticalAlignment="Center"
                                           Margin="8,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCostScan" Style="{StaticResource PrimaryButton}"
                                Click="btnCostScan_Click" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CATIA'yı Tara ve Hesapla" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ======== PARAMETRELER ======== -->
                <Border Grid.Row="1" Margin="24,16,24,10" Padding="14"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Hesap Parametreleri" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Malzeme" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" x:Name="cmbMalzeme"
                                          Style="{StaticResource AppCombo}"
                                          SelectionChanged="cmbMalzeme_SelectionChanged"/>

                                <Button Grid.Column="1" x:Name="btnMalzemeEkle"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="12" Width="30" Height="30" Padding="0"
                                        Margin="6,0,0,0" ToolTip="Özel Malzeme Ekle"
                                        Click="btnMalzemeEkle_Click"/>

                                <Button Grid.Column="2" x:Name="btnMalzemeSil"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="12" Width="30" Height="30" Padding="0"
                                        Margin="6,0,0,0" ToolTip="Özel Malzemeyi Sil"
                                        IsEnabled="False" Click="btnMalzemeSil_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Yoğunluk (g/cm³)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtYogunluk" Style="{StaticResource FieldBox}"
                                     PreviewTextInput="SadeceOndalik"
                                     LostFocus="ParametreDegisti"
                                     TextChanged="ParametreDegisti"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="lblKgFiyat" Text="Malzeme Fiyatı (/kg)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtKgFiyat" Style="{StaticResource FieldBox}"
                                     PreviewTextInput="SadeceOndalik"
                                     LostFocus="ParametreDegisti"
                                     TextChanged="ParametreDegisti"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock x:Name="lblKesimFiyat" Text="Kesim Fiyatı (/m)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtKesimFiyat" Style="{StaticResource FieldBox}"
                                     PreviewTextInput="SadeceOndalik"
                                     LostFocus="ParametreDegisti"
                                     TextChanged="ParametreDegisti"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Para Birimi" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbParaBirimi" Style="{StaticResource AppCombo}"
                                      SelectionChanged="cmbParaBirimi_SelectionChanged">
                                <ComboBoxItem Content="TL (₺)" Tag="₺"/>
                                <ComboBoxItem Content="Euro (€)" Tag="€"/>
                                <ComboBoxItem Content="Dolar ($)" Tag="$"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="10" x:Name="btnYenidenHesapla"
                                Style="{StaticResource PrimaryButton}"
                                Height="30" Padding="14,0" VerticalAlignment="Bottom"
                                ToolTip="Tabloyu Güncel Değerlerle Yeniden Hesapla"
                                Click="btnYenidenHesapla_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Hesapla" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Doviz kurlari -->
                    <Border Background="{StaticResource KpiBlueBgBrush}"
                            BorderBrush="{StaticResource KpiBlueBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="10,7" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource LogInfoBrush}"
                                           Margin="0,0,9,0"/>
                                <TextBlock x:Name="txtKurlar" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="txtKurKaynak" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDisabledBrush}"/>
                                <Button x:Name="btnKurYenile" Style="{StaticResource SecondaryButton}"
                                        Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="11" Width="26" Height="26" Padding="0"
                                        Margin="10,0,0,0" ToolTip="Kurları Yenile"
                                        Click="btnKurYenile_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- ======== MALIYET TABLOSU ======== -->
                <Border Grid.Row="2" Margin="24,0,24,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="costGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource ZebraRow}">
                            <!-- Sutunlar Tablo Ayarlari yapilandirmasindan uretilir -->
                        </DataGrid>

                        <!-- Bos durum -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=costGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Tablo Boş" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Hesaplamak İçin CATIA'yı Tara ve Hesapla'ya Basın"
                                       FontSize="13" Foreground="{StaticResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== OZET KARTLARI ======== -->
                <Grid Grid.Row="3" Margin="24,12,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="14,10,14,11" CornerRadius="4"
                            Background="{StaticResource KpiNeutralBgBrush}"
                            BorderBrush="{StaticResource KpiNeutralBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Ölçülen Parça" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtOzetSatir" Text="0 / 0" FontSize="19"
                                       FontFamily="{StaticResource AppFontDisplay}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="14,10,14,11" CornerRadius="4"
                            Background="{StaticResource KpiBlueBgBrush}"
                            BorderBrush="{StaticResource KpiBlueBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource LogInfoBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Toplam Ağırlık" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtOzetAgirlik" Text="0,00 kg" FontSize="19"
                                       FontFamily="{StaticResource AppFontDisplay}"
                                       Foreground="{StaticResource LogInfoBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Padding="14,10,14,11" CornerRadius="4"
                            Background="{StaticResource KpiGreenBgBrush}"
                            BorderBrush="{StaticResource KpiGreenBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource LogSuccessBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Toplam Kesim" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtOzetKesim" Text="0,0 m" FontSize="19"
                                       FontFamily="{StaticResource AppFontDisplay}"
                                       Foreground="{StaticResource LogSuccessBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Padding="14,10,14,11" CornerRadius="4"
                            Background="{StaticResource KpiWarmBgBrush}"
                            BorderBrush="{StaticResource KpiWarmBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource WarnTextBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Toplam Maliyet" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtOzetMaliyet" Text="0,00" FontSize="19"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFontDisplay}"
                                       Foreground="{StaticResource WarnTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- KONSOL — iki sayfa da ayni kaydi kullanir                          -->
            <!-- ================================================================ -->
            <!-- Konsol kapaliyken sayfanin alti pencereye yapismasin -->
            <Border x:Name="konsolBosluk" Grid.Row="2" Height="16" Visibility="Collapsed"/>

            <Border x:Name="consoleHost" Grid.Row="2" Height="150" Margin="24,10,24,16"
                    Visibility="Collapsed"
                    Background="{StaticResource ConsoleBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Konsol seridi -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GridLineBrush}"
                            BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <TextBlock Text="Konsol" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="btnCopyLog" Style="{StaticResource ConsoleToolButton}"
                                        Width="88" FontFamily="{StaticResource AppFont}" FontSize="11"
                                        Content="Logu Kopyala" ToolTip="Tüm konsol kaydını panoya kopyala"
                                        Click="btnCopyLog_Click"/>
                                <Button x:Name="btnPopOutLog" Style="{StaticResource ConsoleToolButton}"
                                        Content="&#xE8A7;" ToolTip="Ayrı Pencerede Aç"
                                        Margin="2,0,0,0" Click="btnPopOutLog_Click"/>
                                <Button x:Name="btnClearLog" Style="{StaticResource ConsoleToolButton}"
                                        Content="&#xE74D;" ToolTip="Konsolu Temizle"
                                        Margin="2,0,0,0" Click="btnClearLog_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <RichTextBox Grid.Row="1" x:Name="logText" Padding="10,6"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Seçileni Kopyala" Click="btnCopySelectedLog_Click"/>
                                <MenuItem Header="Tümünü Kopyala" Click="btnCopyLog_Click"/>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- BILDIRIMLER — konsol kapaliyken kaydin gorunur hali              -->
            <!-- ================================================================ -->
            <!-- Butun satirlarin uzerinde durur; tiklanınca konsolu acar -->
            <StackPanel x:Name="bildirimKatmani" Grid.Row="0" Grid.RowSpan="3"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,20" Width="360"/>
        </Grid>
    </Border>
</Window>
