<Window x:Class="Macria.YerlesimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görsel Yerleşim"
        Icon="Assets/macria-logo.png"
        Width="1180" Height="780"
        MinWidth="880" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <!-- Buyutulmus pencere kenarlardan tasar, pay verilir -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0">
                <TextBlock Text="Görsel Yerleşim" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="btnKucult" Style="{StaticResource WindowButton}"
                            Content="&#xE921;" Click="btnKucult_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button x:Name="btnBuyut" Click="btnBuyut_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                            Click="btnKapat_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ======== ARAC SERIDI ======== -->
            <Grid Grid.Row="1" Margin="20,2,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Plaka Yerleşimi" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"/>

                        <!-- Ozellik gelisme asamasinda; rozet baslikla ayni
                             taban cizgisine oturur -->
                        <Border Background="{StaticResource KpiWarmBgBrush}"
                                BorderBrush="{StaticResource KpiWarmBorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="7,2,7,3" Margin="10,0,0,3"
                                VerticalAlignment="Bottom"
                                ToolTip="Geliştirme Aşamasında — Sonuçları Üretime Vermeden Önce Doğrulayın">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarnTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="txtAltBaslik" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Secili cesidin kendi payi; bos birakilirsa varsayilan -->
                    <TextBlock Text="Bu Parçanın Payı" FontSize="12.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBox x:Name="txtSeciliPay" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="62" Margin="0,0,16,0" IsEnabled="False"
                             ToolTip="Seçili Parça Çeşidinin Dört Yanındaki Pay (mm)"
                             TextChanged="SeciliPay_TextChanged"/>

                    <Button x:Name="btnDondur" Style="{StaticResource SecondaryButton}"
                            Content="Döndür" Height="32" Padding="14,0"
                            ToolTip="Seçili Parçayı 90° Çevir  (R)"
                            IsEnabled="False" Click="btnDondur_Click"/>

                    <Button x:Name="btnBekle" Style="{StaticResource SecondaryButton}"
                            Content="Beklemeye Al" Height="32" Padding="14,0" Margin="8,0,0,0"
                            ToolTip="Seçili Parçayı Plakadan Çıkar  (Delete)"
                            IsEnabled="False" Click="btnBekle_Click"/>

                    <Button x:Name="btnSigdir" Style="{StaticResource SecondaryButton}"
                            Content="Sığdır" Height="32" Padding="14,0" Margin="8,0,0,0"
                            ToolTip="Görünümü Sıfırla" Click="btnSigdir_Click"/>

                    <Button x:Name="btnResim" Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="14,0" Margin="8,0,0,0"
                            ToolTip="Yerleşimi PNG Görüntüsü Olarak Kaydet"
                            Click="btnResim_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Görüntü" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnOtomatik" Style="{StaticResource PrimaryButton}"
                            Content="Otomatik Yerleştir" Height="32" Padding="18,0"
                            Margin="8,0,0,0"
                            ToolTip="Tüm Parçaları Yeniden Diz"
                            Click="btnOtomatik_Click"/>
                </StackPanel>
            </Grid>

            <!-- ======== PLAKA AYARLARI ======== -->
            <Border Grid.Row="2" Margin="20,14,20,0" Padding="16,10" CornerRadius="4"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Plaka" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtBoy" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="86" ToolTip="Plaka Boyu (mm)"
                             TextChanged="Ayar_TextChanged"/>

                    <TextBlock Text="×" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}"
                               Margin="8,0,8,0"/>

                    <TextBox x:Name="txtEn" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="86" ToolTip="Plaka Eni (mm)"
                             TextChanged="Ayar_TextChanged"/>

                    <TextBlock Text="mm" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}"
                               Margin="8,0,0,0"/>

                    <Border Width="1" Margin="18,4,18,4"
                            Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="Parça Payı" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtPay" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="66"
                             ToolTip="Her Parçanın Dört Yanındaki Pay (mm) — İki Komşu Arasındaki Açıklık Bu Payların Toplamıdır"
                             TextChanged="Ayar_TextChanged"/>

                    <TextBlock Text="Kenar Payı" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="18,0,10,0"/>

                    <TextBox x:Name="txtKenar" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="66" ToolTip="Plaka Kenar Payı (mm)"
                             TextChanged="Ayar_TextChanged"/>

                    <Border Width="1" Margin="18,4,18,4"
                            Background="{StaticResource BorderBrush}"/>

                    <!-- Fire agirligi ve bedeli icin malzeme ve fiyat -->
                    <ComboBox x:Name="cmbMalzeme" Style="{StaticResource AppCombo}"
                              Width="180" VerticalAlignment="Center"
                              ToolTip="Fire Ağırlığı Bu Malzemenin Yoğunluğuyla Hesaplanır"
                              SelectionChanged="cmbMalzeme_SelectionChanged"/>

                    <Button x:Name="btnMalzemeEkle" Style="{StaticResource SecondaryButton}"
                            Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Width="30" Height="30" Padding="0"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            ToolTip="Özel Malzeme Ekle"
                            Click="btnMalzemeEkle_Click"/>

                    <Button x:Name="btnMalzemeSil" Style="{StaticResource SecondaryButton}"
                            Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Width="30" Height="30" Padding="0"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            IsEnabled="False"
                            ToolTip="Seçili Özel Malzemeyi Sil"
                            Click="btnMalzemeSil_Click"/>

                    <TextBlock x:Name="txtKgEtiket" Text="Kg Fiyatı" FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="18,0,10,0"/>

                    <TextBox x:Name="txtKgFiyat" Style="{StaticResource FieldBox}"
                             PreviewTextInput="SadeceOndalik"
                             Width="78" ToolTip="Birim Para / kg"
                             TextChanged="Fiyat_TextChanged"/>

                    <TextBlock x:Name="txtAyarUyari" FontSize="12"
                               Foreground="{StaticResource WarnTextBrush}"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======== TUVAL ======== -->
            <!-- Bos alanda surukleme gorunumu kaydirir, parca uzerinde
                 surukleme parcayi tasir. Tekerlek yakinlastirir. -->
            <Border Grid.Row="3" Margin="20,12,20,0" CornerRadius="4"
                    Background="{StaticResource ConsoleBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="tuval" Background="Transparent"
                            ClipToBounds="True"
                            SizeChanged="tuval_SizeChanged"
                            MouseWheel="tuval_MouseWheel"
                            MouseLeftButtonDown="tuval_MouseLeftButtonDown"
                            MouseMove="tuval_MouseMove"
                            MouseLeftButtonUp="tuval_MouseLeftButtonUp">
                        <Canvas x:Name="ic">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="olcek"/>
                                    <TranslateTransform x:Name="kaydir"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>

                    <TextBlock x:Name="txtBosMesaj" FontSize="13"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                               Foreground="{StaticResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ======== FIRE KARTLARI ======== -->
            <!-- Yerlesim her degistiginde canli guncellenir -->
            <Grid Grid.Row="4" Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16,10" CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Satın Alınan Sac" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtSac" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtSacAlt" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16,10" CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Parçalar" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtParcaKg" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtParcaAlt" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="16,10" CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Fire" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtFire" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"
                                   Foreground="{StaticResource WarnTextBrush}"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtFireAlt" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Padding="16,10" CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Fire Bedeli" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtFireBedel" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontDisplay}"
                                   Foreground="{StaticResource WarnTextBrush}"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtFireBedelAlt" FontSize="11.5" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDisabledBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="5" Margin="0,16,0,0" Padding="24,12"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtDurum" FontSize="12.5"/>
                        <TextBlock x:Name="txtIpucu" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="Parçayı sürükleyerek taşıyın · R döndürür · Delete beklemeye alır · Boş alanda sürükleme görünümü kaydırır"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Content="Kapat" Height="32" Padding="18,0"
                            VerticalAlignment="Center"
                            Click="btnKapat_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
