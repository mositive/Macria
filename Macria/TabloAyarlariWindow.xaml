<Window x:Class="Macria.TabloAyarlariWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tablo Ayarları"
        Icon="Assets/macria-logo.png"
        Width="1000" Height="740"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Bir sutun satiri -->
        <DataTemplate x:Key="SutunSatiriSablonu">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding Gorunur}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="Tabloda ve raporda göster"/>

                        <TextBox Grid.Column="1" Text="{Binding Baslik, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}" Height="28"
                                 VerticalAlignment="Center"/>

                        <Border Grid.Column="2" CornerRadius="3" Padding="8,3" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{Binding TurRengi}" BorderThickness="1">
                            <TextBlock Text="{Binding TurEtiketi}" FontSize="10.5"
                                       Foreground="{Binding TurRengi}"/>
                        </Border>

                        <TextBlock Grid.Column="3" Text="{Binding Aciklama}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,10,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding AciklamaGorunur}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding OndalikGorunur}">
                            <TextBlock Text="Ondalık" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding Ondalik, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Width="46" Height="28"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Content="&#xE74A;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Width="28" Height="28" Padding="0" ToolTip="Yukarı Taşı"
                                    Click="btnYukari_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="&#xE74B;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                    ToolTip="Aşağı Taşı" Click="btnAsagi_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                    ToolTip="Sütunu Sil" Click="btnSutunSil_Click"
                                    Visibility="{Binding SilGorunur}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Yalnizca ozel sutunlarda: formul ve formuldeki adi -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding FormulGorunur}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Formüldeki Adı" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Anahtar, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}" Height="28"/>

                        <TextBlock Grid.Column="2" Text="Formül" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <TextBox Grid.Column="3" Text="{Binding Formul, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}" Height="28"
                                 FontFamily="Cascadia Mono, Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Bir parametre satiri -->
        <DataTemplate x:Key="ParametreSatiriSablonu">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="28"
                             ToolTip="Parametrenin adı"/>
                    <TextBox Grid.Column="2" Text="{Binding Anahtar, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="28"
                             FontFamily="Cascadia Mono, Consolas"
                             ToolTip="Formülde kullanılacak ad"/>
                    <TextBox Grid.Column="4" Text="{Binding Deger, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="28"
                             ToolTip="Değer"/>
                    <TextBox Grid.Column="6" Text="{Binding Birim, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="28"
                             ToolTip="Birim (isteğe bağlı)"/>

                    <Button Grid.Column="8" Style="{StaticResource SecondaryButton}" Content="&#xE74D;"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Width="28" Height="28" Padding="0" ToolTip="Parametreyi Sil"
                            Click="btnParametreSil_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/macria-logo.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Tablo Ayarları" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnVazgec_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
                <StackPanel Margin="0,4,0,16">

                    <TextBlock Text="Sütunlar" FontSize="14" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,10"
                               Text="Sütunları gizleyebilir, sıralarını ve başlıklarını değiştirebilirsiniz. CATIA'dan gelen ve Macria'nın hesapladığı sütunların hesap yöntemi sabittir; kendi sütununuzu ekleyip formülünü siz yazabilirsiniz."/>

                    <ItemsControl x:Name="listeSutunlar"
                                  ItemTemplate="{StaticResource SutunSatiriSablonu}"/>

                    <Button x:Name="btnSutunEkle" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Height="30" Padding="14,0"
                            Margin="0,4,0,0" Click="btnSutunEkle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Sütun Ekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Parametreler" FontSize="14" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"
                               Margin="0,22,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,10"
                               Text="Kendi değerlerinizi tanımlayın (fire oranı, KDV, işçilik gibi). Formüllerde &quot;formüldeki adı&quot; ile kullanılır."/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Adı" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="11,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Formüldeki Adı" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="Değer" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="6" Text="Birim" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <ItemsControl x:Name="listeParametreler"
                                  ItemTemplate="{StaticResource ParametreSatiriSablonu}"/>

                    <Button x:Name="btnParametreEkle" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Height="30" Padding="14,0"
                            Margin="0,4,0,0" Click="btnParametreEkle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Parametre Ekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Formülde Kullanabilecekleriniz" FontSize="14" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"
                               Margin="0,22,0,0"/>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <ItemsControl x:Name="listeDegiskenler">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Ad}" FontSize="12"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{StaticResource LogInfoBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Aciklama}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{StaticResource BorderBrush}" Height="1"
                                    Margin="0,10,0,10"/>

                            <TextBlock x:Name="txtFonksiyonlar" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="İşleçler: + − × (*) ÷ (/) kalan (%) üs (^) ve parantez. Ölçülemeyen bir parçada formülde kullanılan değer yoksa hücre boş kalır."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <Button x:Name="btnVarsayilan" Style="{StaticResource SecondaryButton}"
                            Content="Varsayılanlara Dön" Height="32" Padding="16,0"
                            HorizontalAlignment="Left" Click="btnVarsayilan_Click"/>

                    <TextBlock x:Name="txtDurum" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="220,0,220,0"
                               Foreground="{StaticResource LogErrorBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç"
                                Height="32" Padding="16,0" Click="btnVazgec_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Kaydet"
                                Height="32" Padding="16,0" Margin="8,0,0,0"
                                Click="btnKaydet_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
