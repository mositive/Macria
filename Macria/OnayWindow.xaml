<Window x:Class="Macria.OnayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay"
        Icon="Assets/macria-logo.png"
        Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <TextBlock x:Name="txtBaslik" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnVazgec_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <TextBlock x:Name="txtMesaj" Grid.Row="1" Margin="24,4,24,4"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnVazgec" Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="16,0" Click="btnVazgec_Click"/>
                    <Button x:Name="btnOnay" Style="{StaticResource PrimaryButton}"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            IsDefault="True" Click="btnOnay_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
