<Window x:Class="Macria.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rehber"
        Icon="Assets/macria-logo.png"
        Width="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/macria-logo.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Save As Konumunu Öğretme Rehberi" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnKapat_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <StackPanel Grid.Row="1" Margin="24,4,24,0">

                <!-- Adim basligi -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                            Width="26" Height="26" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAdimNo" Text="1" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtAdimBaslik" Text="" FontSize="16" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="txtAdimAciklama" FontSize="13" LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"/>

                <!-- Gorsel -->
                <Border Background="{StaticResource ConsoleBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Height="340" Margin="0,12,0,0"
                        Padding="10" ClipToBounds="True">
                    <Image x:Name="imgAdim" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Nokta gostergesi -->
                <StackPanel x:Name="pnlNoktalar" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <Button x:Name="btnGeri" Style="{StaticResource SecondaryButton}"
                            Content="Geri" Height="32" Padding="16,0"
                            HorizontalAlignment="Left" Click="btnGeri_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnOgretmeyeBasla" Style="{StaticResource SuccessButton}"
                                Height="32" Padding="16,0" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="btnOgretmeyeBasla_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Öğretmeye Başla" VerticalAlignment="Center"/>
                                <TextBlock Text="→" FontSize="14" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnIleri" Style="{StaticResource PrimaryButton}"
                                Content="İleri" Height="32" Padding="16,0"
                                Click="btnIleri_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
