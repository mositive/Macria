<Window x:Class="Macria.DxfCakismaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF Zaten Var"
        Icon="Assets/macria-logo.png"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <TextBlock Text="DXF Zaten Var" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnIptal_Click"/>
            </Grid>

            <TextBlock x:Name="txtMesaj" Grid.Row="1" Margin="24,4,24,4"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <CheckBox x:Name="chkTumune" Grid.Row="2" Margin="24,12,24,0"
                      Content="Bu kararı kalan tüm aynı adlı dosyalara uygula"/>

            <Border Grid.Row="3" Margin="0,18,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="İptal"
                            Height="32" Padding="16,0" IsCancel="True" Click="btnIptal_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Üzerine Yaz"
                            Height="32" Padding="16,0" Margin="8,0,0,0" Click="btnUzerineYaz_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Atla"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            IsDefault="True" Click="btnAtla_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
