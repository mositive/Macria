<Window x:Class="Macria.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Icon="Assets/macria-logo.png"
        Width="820" Height="640" MinWidth="620" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <!-- Boyutlandirilabilir cercevesiz pencere: bastan tasinir, kenarlardan boyutlanir -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Soldaki kategori listesi -->
        <Style x:Key="KategoriItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="kart" Background="Transparent" CornerRadius="4" Padding="12,8" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="kart" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="kart" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="Ayarlar" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="btnClose_Click"/>
            </Grid>

            <!-- ======== ICERIK: solda kategoriler, sagda kaydirilabilir ayarlar ======== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="lstKategori" Grid.Column="0" Margin="12,4,8,12"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource KategoriItem}"
                         SelectionChanged="lstKategori_SelectionChanged">
                    <ListBoxItem Content="Save As Konumu" Tag="bolumSaveAs"/>
                    <ListBoxItem Content="Büküm Bilgisi" Tag="bolumBukum"/>
                    <ListBoxItem Content="Zamanlama" Tag="bolumZamanlama"/>
                    <ListBoxItem Content="Sac Üretim Grubu" Tag="bolumSac"/>
                    <ListBoxItem Content="Dosya Analizi" Tag="bolumDosyaAnalizi"/>
                    <ListBoxItem Content="Görünüm" Tag="bolumGorunum"/>
                    <ListBoxItem Content="Teşhis" Tag="bolumTeshis"/>
                    <ListBoxItem Content="Uyarılar" Tag="bolumUyarilar"/>
                </ListBox>

                <ScrollViewer x:Name="ayarKaydirici" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" ScrollChanged="ayarKaydirici_ScrollChanged">
            <StackPanel x:Name="pnlAyarlar" Margin="12,4,24,16">

                <!-- Save As Konumu -->
                <TextBlock x:Name="bolumSaveAs" Text="Save As Konumu" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Bazı kurulumlarda CATIA paneli klavyeyle tıklanamaz. Butonun yerini bir kez öğretirseniz Macria her seferinde doğrudan oraya tıklar."/>

                        <TextBlock x:Name="txtKonum" FontSize="12.5" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="btnOgret" Style="{StaticResource PrimaryButton}"
                                    Content="Konumu Öğret" Height="30" Padding="14,0"
                                    Click="btnOgret_Click"/>
                            <Button x:Name="btnTemizle" Style="{StaticResource SecondaryButton}"
                                    Content="Temizle" Height="30" Padding="14,0"
                                    Margin="8,0,0,0" Click="btnTemizle_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bukum Bilgisi -->
                <TextBlock x:Name="bolumBukum" Text="Büküm Bilgisi (Bend Information)" FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkBukumKapat"
                                  Content="Export Öncesi Kutuyu Kaldır"/>

                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="24,8,0,0"
                                   Text="Save as Dxf panelindeki &quot;Bend Information&quot; işaretliyken CATIA bazı parçalarda çökebiliyor. Macria, Save As'e basmadan hemen önce kutuyu kaldırır. Kutunun yerini bir kez öğretmeniz gerekir: panelde kutu İŞARETLİYKEN üzerine gelip F8'e basın."/>

                        <TextBlock x:Name="txtBukum" FontSize="12.5" Margin="24,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="24,12,0,0">
                            <Button x:Name="btnBukumOgret" Style="{StaticResource PrimaryButton}"
                                    Content="Kutuyu Öğret" Height="30" Padding="14,0"
                                    Click="btnBukumOgret_Click"/>
                            <Button x:Name="btnBukumTemizle" Style="{StaticResource SecondaryButton}"
                                    Content="Temizle" Height="30" Padding="14,0"
                                    Margin="8,0,0,0" Click="btnBukumTemizle_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Zamanlama -->
                <TextBlock x:Name="bolumZamanlama" Text="Zamanlama" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Panel Bekleme Süresi (ms)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBekleme" Style="{StaticResource FieldBox}"
                                 Width="130" HorizontalAlignment="Left"
                                 PreviewTextInput="SadeceSayi"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Yavaş makinelerde panel geç açılıyorsa bu süreyi artırın."/>
                    </StackPanel>
                </Border>

                <!-- Sac uretim grubu -->
                <TextBlock x:Name="bolumSac" Text="Sac Üretim Grubu" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Lazer Azami Kalınlık (mm)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLazerKalinlik" Style="{StaticResource FieldBox}"
                                 Width="130" HorizontalAlignment="Left"
                                 PreviewTextInput="SadeceOndalik"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Bu kalınlığa eşit ve daha ince saclar Lazer, daha kalınlar Şalama/Kütük grubunda listelenir. İki grubun da DXF'i üretilir."/>
                        <CheckBox x:Name="chkBukumBilgisiDxf" Margin="0,12,0,0"
                                  Content="Büküm bilgisi DXF'e yazılsın"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="24,6,0,0"
                                   Text="Açıkken büküm bölgesinin sınırları kesik-noktalı çizgi ve büküm etiketi BUKUM katmanına yazılır. Kapalıyken DXF'te yalnız kontur ve delikler (KESIM katmanı) bulunur."/>
                    </StackPanel>
                </Border>

                <!-- Dosya analizi (geometri motoru) -->
                <TextBlock x:Name="bolumDosyaAnalizi" Text="Dosya Analizi" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Parça Başına Süre Sınırı (saniye)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtParcaSureSiniri" Style="{StaticResource FieldBox}"
                                 Width="130" HorizontalAlignment="Left"
                                 PreviewTextInput="SadeceSayi"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Bu süreyi aşan parça Kontrol gerekli sekmesine düşer (analiz süresi aşıldı); montajın geri kalanı analiz edilir. 0 = sınırsız."/>
                        <TextBlock Text="İş Parçacığı Sayısı" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,5"/>
                        <TextBox x:Name="txtMotorIsParcacigi" Style="{StaticResource FieldBox}"
                                 Width="130" HorizontalAlignment="Left"
                                 PreviewTextInput="SadeceSayi"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Parçalar bu kadar iş parçacığında paralel analiz edilir; sonuç değişmez. 0 = otomatik (çekirdek sayısı − 1)."/>
                    </StackPanel>
                </Border>

                <!-- Gorunum -->
                <TextBlock x:Name="bolumGorunum" Text="Görünüm" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Buton Görünümü" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbDugmeGorunumu" Style="{StaticResource AppCombo}"
                                  Width="200" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Buton Görünümü">
                            <ComboBoxItem Content="İkon ve ad"/>
                            <ComboBoxItem Content="Yalnız ikon"/>
                        </ComboBox>
                        <TextBlock Text="İkon Boyutu" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,5"/>
                        <ComboBox x:Name="cmbDugmeBoyutu" Style="{StaticResource AppCombo}"
                                  Width="260" HorizontalAlignment="Left"
                                  AutomationProperties.Name="İkon Boyutu">
                            <ComboBoxItem Content="Küçük (ikon 16, buton 36 px)"/>
                            <ComboBoxItem Content="Orta (ikon 24, buton 40 px)"/>
                            <ComboBoxItem Content="Büyük (ikon 32, buton 48 px)"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Bütün ekranlardaki ikonlu butonlar (Dosya Analiz Merkezi, Toplu DXF, DXF Düzenleme, Plaka Yerleşimi). İkon ve ad Küçük, Yalnız ikon Büyük boyutla başlar; boyutu değiştirebilirsiniz. Yalnız ikon modunda butonun adı ipucunda görünür. Kaydet'e basınca hemen uygulanır."/>
                    </StackPanel>
                </Border>

                <!-- Teshis -->
                <TextBlock x:Name="bolumTeshis" Text="Teşhis" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkGomuluTeshis"
                                  Content="3B önizleme teşhis kayıtları"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="24,6,0,0"
                                   Text="Açıkken 3B önizlemedeki fare/pencere olayları (WM_...) konsola yazılır; bildirim kartı olarak gösterilmez. Yalnız sorun ararken açın."/>
                    </StackPanel>
                </Border>

                <!-- Uyarilar -->
                <TextBlock x:Name="bolumUyarilar" Text="Uyarılar" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkFareUyarisi"
                                  Content="Export Öncesi Bilgilendirmeyi Göster"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="24,8,0,0"
                                   Text="Fare imlecinin neden kendi kendine hareket ettiğini anlatan ve export sırasında fareye dokunulmaması gerektiğini hatırlatan pencere. Hem tek parça hem toplu aktarımdan önce çıkar."/>
                    </StackPanel>
                </Border>
            </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== ALT SERIT: her zaman gorunur ======== -->
            <Border Grid.Row="2" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç"
                            Height="32" Padding="16,0" Click="btnClose_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Kaydet"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            Click="btnKaydet_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
