<Window x:Class="Macria.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Icon="Assets/macria-logo.png"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <TextBlock Text="Ayarlar" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnClose_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <StackPanel Grid.Row="1" Margin="24,4,24,0">

                <!-- Save As Konumu -->
                <TextBlock Text="Save As Konumu" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Bazı kurulumlarda CATIA paneli klavyeyle tıklanamaz. Butonun yerini bir kez öğretirseniz Macria her seferinde doğrudan oraya tıklar."/>

                        <TextBlock x:Name="txtKonum" FontSize="12.5" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="btnOgret" Style="{StaticResource PrimaryButton}"
                                    Content="Konumu Öğret" Height="30" Padding="14,0"
                                    Click="btnOgret_Click"/>
                            <Button x:Name="btnTemizle" Style="{StaticResource SecondaryButton}"
                                    Content="Temizle" Height="30" Padding="14,0"
                                    Margin="8,0,0,0" Click="btnTemizle_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Zamanlama -->
                <TextBlock Text="Zamanlama" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Panel Bekleme Süresi (ms)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBekleme" Style="{StaticResource FieldBox}"
                                 Width="130" HorizontalAlignment="Left"
                                 PreviewTextInput="SadeceSayi"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Text="Yavaş makinelerde panel geç açılıyorsa bu süreyi artırın."/>
                    </StackPanel>
                </Border>

                <!-- Uyarilar -->
                <TextBlock Text="Uyarılar" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,20,0,0"/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkFareUyarisi"
                                  Content="Toplu Export Öncesi Fare Uyarısını Göster"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="24,8,0,0"
                                   Text="Export sırasında fareye dokunulmaması gerektiğini hatırlatan bilgilendirme penceresi."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Margin="0,22,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç"
                            Height="32" Padding="16,0" Click="btnClose_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Kaydet"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            Click="btnKaydet_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
