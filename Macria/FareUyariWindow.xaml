<Window x:Class="Macria.FareUyariWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Uyarısı"
        Icon="Assets/macria-logo.png"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/macria-logo.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Export Başlamadan Önce" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnVazgec_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <StackPanel Grid.Row="1" Margin="24,4,24,0">

                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Width="30" Height="30" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="15" Foreground="#D08B3C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Fareye ve Klavyeye Dokunmayın" FontSize="16" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0"
                           Text="Macria her parça için CATIA'nın Save As düğmesine öğrettiğiniz konuma gerçek fare tıklaması yapar. Export sürerken imleci oynatırsanız veya başka bir pencereye tıklarsanız tıklama yanlış yere gider ve o parçanın aktarımı başarısız olur."/>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14,12" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="İşlem boyunca fareyi ve klavyeyi bırakın, CATIA penceresini de taşımayın."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource LogSuccessBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Yanlışlıkla dokunursanız endişelenmeyin: Macria her parçayı 3 kez dener. Yine de aktarılamayan parçalar konsolda listelenir; listeden sağ tıklayıp tek tek yeniden aktarabilir ya da tüm işlemi tekrar başlatabilirsiniz."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <CheckBox x:Name="chkGizle" Content="Bu Uyarıyı Bir Daha Gösterme"
                              IsChecked="False"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Vazgeç" Height="32" Padding="16,0" Margin="0,0,8,0"
                                Click="btnVazgec_Click"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Height="32" Padding="16,0" IsDefault="True"
                                Click="btnBaslat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Anladım, Başlat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
