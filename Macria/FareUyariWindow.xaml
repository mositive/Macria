<Window x:Class="Macria.FareUyariWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Bilgilendirme"
        Icon="Assets/macria-logo.png"
        Width="580" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Baslik_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/macria-logo.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Export Başlamadan Önce" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="btnVazgec_Click"/>
            </Grid>

            <!-- ======== ICERIK ======== -->
            <StackPanel Grid.Row="1" Margin="24,4,24,0">

                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource KpiGreenBgBrush}"
                            BorderBrush="{StaticResource KpiGreenBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Width="32" Height="32" VerticalAlignment="Center">
                        <!-- Kalkan simgesi: yazi tipine bagli kalmasin diye cizili -->
                        <Path Data="M8,1 L14.5,3.4 V8.2 C14.5,11.8 8,14.8 8,14.8 C8,14.8 1.5,11.8 1.5,8.2 V3.4 Z M5.4,8 L7.2,9.9 L10.7,6.2"
                              Stroke="{StaticResource LogSuccessBrush}" StrokeThickness="1.3"
                              StrokeLineJoin="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Merak Etmeyin, Bilgisayarınız Güvende." FontSize="17" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"
                               VerticalAlignment="Center" Margin="11,0,0,0"/>
                </StackPanel>

                <TextBlock FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,13,0,0"
                           Text="Birazdan Macria farenizi hareket ettirip DXF Export alacak. Bu, Macria'nın parçaları dışa aktarma yöntemidir. Merak etmeyin, bilgisayarınızı uzaktan kontrol etmiyoruz."/>

                <TextBlock FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,10,0,0"
                           Text="CATIA'nın kaydetme paneli, dışarıdan tetiklenebilecek bir düğme sunmuyor. Tek yol, düğmenin bulunduğu yere gerçek bir fare tıklaması göndermek. Gördüğünüz hareketin tamamı bundan ibaret. Başka bir yöntem mevcut olsaydı emin olun bu yönteme başvurmazdık :)"/>

                <!-- Ne yapiyor, ne yapmiyor -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14,12" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource LogSuccessBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Macria yalnızca CATIA penceresine tıklar. Tuş vuruşlarınızı kaydetmez, ekranınızı izlemez, başka bir uygulamaya dokunmaz."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource LogSuccessBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="DXF dosyaları yalnızca sizin seçtiğiniz klasöre yazılır. Dışa aktarım boyunca internete hiçbir veri gönderilmez."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource LogSuccessBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Macria'nın yaptığı her adım aşağıdaki konsola yazılır; ne olduğunu adım adım izleyebilirsiniz. Durdurmak isterseniz Durdur düğmesi her an açıktır."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pratik uyari -->
                <Border Background="{StaticResource KpiWarmBgBrush}"
                        BorderBrush="{StaticResource KpiWarmBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource WarnTextBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="İşlem sürerken fareye ve klavyeye dokunmayın, CATIA penceresini taşımayın. İmleci oynatırsanız tıklama yanlış yere gider ve o parça aktarılamaz."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Width="452"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Yanlışlıkla dokunursanız endişelenmeyin: Macria her parçayı 3 kez dener. Yine de aktarılamayanlar konsolda listelenir; listeden sağ tıklayıp tek tek yeniden aktarabilirsiniz."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="24,14"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <CheckBox x:Name="chkGizle" Content="Bunu Bir Daha Gösterme"
                              IsChecked="False"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Vazgeç" Height="32" Padding="16,0" Margin="0,0,8,0"
                                Click="btnVazgec_Click"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Height="32" Padding="16,0" IsDefault="True"
                                Click="btnBaslat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Anladım, Başlat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
