<Window x:Class="Macria.OnizlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macria — DXF Önizleme"
        Icon="Assets/macria-logo.png"
        Height="640" Width="860"
        MinHeight="320" MinWidth="480"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/macria-logo.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="DXF Önizleme" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="btnMin" Style="{StaticResource WindowButton}"
                            Content="&#xE921;" Click="btnMin_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="btnMax" Click="btnMax_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource WindowCloseButton}"
                            Content="&#xE8BB;" Click="btnClose_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ======== PARCA SERIDI ======== -->
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                    <TextBlock x:Name="txtParca" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="Listeden Bir Parça Seçin"/>
                    <TextBlock x:Name="txtDosya" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{StaticResource TextDisabledBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="btnSigdir" Style="{StaticResource SecondaryButton}"
                            Content="Sığdır" Height="30" Padding="14,0"
                            ToolTip="Yakınlaştırmayı Sıfırla"
                            Click="btnSigdir_Click"/>
                    <Button x:Name="btnAc" Style="{StaticResource SecondaryButton}"
                            Content="Dosyayı Aç" Height="30" Padding="14,0" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="btnAc_Click"/>
                </StackPanel>
            </Grid>

            <!-- ======== CIZIM ======== -->
            <!-- Tekerlek yakinlastirir, surukleme kaydirir; ikisi de katmanin
                 donusumunu degistirir, dosya yeniden okunmaz. -->
            <Border Grid.Row="2" Margin="16,0,16,0" Padding="18"
                    Background="{StaticResource ConsoleBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True">
                <Grid x:Name="cizimAlani" Background="Transparent"
                      MouseWheel="cizimAlani_MouseWheel"
                      MouseLeftButtonDown="cizimAlani_MouseLeftButtonDown"
                      MouseMove="cizimAlani_MouseMove"
                      MouseLeftButtonUp="cizimAlani_MouseLeftButtonUp">
                    <Grid x:Name="cizimKatmani" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="olcek"/>
                                <TranslateTransform x:Name="kaydir"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Path x:Name="cizim" Stretch="Uniform"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock x:Name="txtMesaj" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="380"
                               Foreground="{StaticResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Text="Önizlemek için listeden bir satır seçin."/>
                </Grid>
            </Border>

            <!-- ======== ALT SERIT ======== -->
            <Grid Grid.Row="3" Margin="16,10,16,16">
                <TextBlock x:Name="txtOlcu" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtYakinlik" FontSize="12.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}"
                           Text="%100"/>
            </Grid>
        </Grid>
    </Border>
</Window>
