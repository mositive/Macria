<Window x:Class="Macria.GrafikWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grafikler"
        Icon="Assets/macria-logo.png"
        Width="1080" Height="740"
        MinWidth="760" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <!-- Buyutulmus pencere kenarlardan tasar, pay verilir -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== BASLIK CUBUGU ======== -->
            <Grid Grid.Row="0">
                <TextBlock Text="Grafikler" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="btnKucult" Style="{StaticResource WindowButton}"
                            Content="&#xE921;" Click="btnKucult_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button x:Name="btnBuyut" Click="btnBuyut_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                            Click="btnKapat_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ======== OZET SERIDI ======== -->
            <Grid Grid.Row="1" Margin="20,2,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Ağırlık ve Maliyet Dağılımı" FontSize="18"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontDisplay}"/>
                    <TextBlock x:Name="txtAltBaslik" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="btnResim" Style="{StaticResource SecondaryButton}"
                        Height="32" Padding="14,0" VerticalAlignment="Center"
                        ToolTip="Grafikleri PNG Görüntüsü Olarak Kaydet"
                        Click="btnResim_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Görüntü Olarak Kaydet" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ======== GRAFIKLER ======== -->
            <Grid x:Name="pano" Grid.Row="2" Margin="20,14,20,0"
                  Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Kalinliga gore agirlik -->
                <Border Grid.Row="0" Grid.Column="0" Padding="16,12,16,10"
                        CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Kalınlığa Göre Ağırlık" FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Hangi Sac Kalınlığı Ağırlığın Ne Kadarını Taşıyor"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="tuvalKalinlik" ClipToBounds="True"
                                SizeChanged="Tuval_SizeChanged"/>
                    </DockPanel>
                </Border>

                <!-- Maliyet dagilimi -->
                <Border Grid.Row="0" Grid.Column="2" Padding="16,12,16,10"
                        CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Maliyet Dağılımı" FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Malzeme Bedeli ile Kesim Bedelinin Payı"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="tuvalDagilim" ClipToBounds="True"
                                SizeChanged="Tuval_SizeChanged"/>
                    </DockPanel>
                </Border>

                <!-- En pahali parcalar -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Padding="16,12,16,10" CornerRadius="4"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="txtPahaliBaslik" Text="En Yüksek Maliyetli Parçalar"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Toplam Maliyetin Yoğunlaştığı Parçalar — Adet Dahil"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="tuvalPahali" ClipToBounds="True"
                                SizeChanged="Tuval_SizeChanged"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ======== ALT SERIT ======== -->
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="24,12"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="0,0,3,3">
                <Grid>
                    <TextBlock x:Name="txtDurum" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource TextDisabledBrush}"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="Kapat"
                            Height="32" Padding="18,0" HorizontalAlignment="Right"
                            Click="btnKapat_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
