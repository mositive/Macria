<Style x:Key="MacriaIconOnlyButton" TargetType="Button">
 <Setter Property="Width" Value="36"/>
 <Setter Property="Height" Value="36"/>
 <Setter Property="Padding" Value="8"/>
 <Setter Property="Margin" Value="0,0,6,6"/>
 <Setter Property="Background" Value="#2A2A28"/>
 <Setter Property="BorderBrush" Value="#42423E"/>
 <Setter Property="BorderThickness" Value="1"/>
 <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
 <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/>
 <Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
  <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
   <Image Source="{TemplateBinding Content}" Stretch="Uniform" Width="18" Height="18"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#343B44"/><Setter TargetName="Frame" Property="BorderBrush" Value="#588CD0"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9BC6FF"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#234D80"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="MacriaNamedIconButton" TargetType="Button">
 <Setter Property="MinWidth" Value="36"/>
 <Setter Property="Height" Value="36"/>
 <Setter Property="Padding" Value="10,6"/>
 <Setter Property="Margin" Value="0,0,6,6"/>
 <Setter Property="Background" Value="#2A2A28"/>
 <Setter Property="BorderBrush" Value="#42423E"/>
 <Setter Property="BorderThickness" Value="1"/>
 <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
 <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/>
 <Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
  <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
   <StackPanel Orientation="Horizontal"><Image Source="{TemplateBinding Content}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#ECEAE2" FontSize="12" VerticalAlignment="Center"/></StackPanel>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#343B44"/><Setter TargetName="Frame" Property="BorderBrush" Value="#588CD0"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9BC6FF"/></Trigger>
